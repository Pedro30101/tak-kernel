-void gui_clear_console(void) {
-    if (fb == NULL) return;
-    const int redraw_pointer = pointer_drawn;
-    if (redraw_pointer) gui_mouse_erase();
-    fill_rect(console_x, console_y, GUI_COLS * cell_width,
-              GUI_ROWS * cell_height, 0xFF202938);
-    if (redraw_pointer) draw_pointer();
-}
-
-void gui_draw_cell(size_t index, uint16_t cell) {
-    if (fb == NULL || index >= GUI_COLS * GUI_ROWS) return;
-    const uint32_t x = console_x + (uint32_t)(index % GUI_COLS) * cell_width;
-    const uint32_t y = console_y + (uint32_t)(index / GUI_COLS) * cell_height;
-    const uint8_t attributes = (uint8_t)(cell >> 8);
-    const uint32_t fg = vga_color(attributes & 0x0F);
-    const uint32_t bg = vga_color(attributes >> 4);
-    const uint32_t scale = cell_width >= 12 ? 2 : 1;
-    const int overlaps_pointer = pointer_drawn &&
-        x < (uint32_t)pointer_x + POINTER_WIDTH && x + cell_width > (uint32_t)pointer_x &&
-        y < (uint32_t)pointer_y + POINTER_HEIGHT && y + cell_height > (uint32_t)pointer_y;
-    if (overlaps_pointer) gui_mouse_erase();
-    draw_glyph(x, y, (char)(uint8_t)cell, fg, bg, scale);
-    if (overlaps_pointer) draw_pointer();
-}
