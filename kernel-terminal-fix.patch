-void gui_redraw_console(const volatile uint16_t *cells, size_t count) {
-    if (fb == NULL) return;
-    gui_clear_console();
-    for (size_t i = 0; i < count && i < GUI_COLS * GUI_ROWS; ++i) gui_draw_cell(i, cells[i]);
-}
